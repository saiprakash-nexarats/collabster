# ==============================================================================
# Collobster Application Configuration (Canonical Architecture)
# ==============================================================================

# Frontend Backend API Endpoint
# - For local development against standalone Spring Boot backend: http://localhost:8080
# - For Docker Compose / Nginx reverse proxy: /api
VITE_API_URL=http://localhost:8080

# Database Configuration (PostgreSQL)
POSTGRES_DB=collabster1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-database-password

# Cache & Realtime State (Redis)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Security & Session Authentication
JWT_SECRET=replace-with-a-minimum-32-byte-secure-random-secret
COLLOBSTER_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8080,http://localhost:3000

# Service Tokens & Storage Keys
COLLOBSTER_RECOMMENDATION_INTERNAL_TOKEN=replace-with-a-service-to-service-token
COLLABSTER_STORAGE_SIGNING_SECRET=replace-with-a-storage-signing-secret

# Browser OIDC / OAuth2 Flow with PKCE (Optional)
# VITE_OIDC_ISSUER=https://identity.example.com
# VITE_OIDC_CLIENT_ID=collobster-web
# VITE_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/authorize
# VITE_OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth/token
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/
