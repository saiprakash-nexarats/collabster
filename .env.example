# ==============================================================================
# Collobster Web Application Configuration
# ==============================================================================

# Backend API URL (optional)
# Connects to your live or local Collobster backend API (e.g., https://collobster-api.onrender.com).
# When omitted or blank, the web application runs in rich, offline-first Preview Mode with device-local persistence.
VITE_API_URL=https://collobster-api.onrender.com

# Docker / Spring Boot runtime secrets. Generate unique values for every environment.
POSTGRES_DB=collabster1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-minimum-32-byte-random-secret
COLLOBSTER_RECOMMENDATION_INTERNAL_TOKEN=replace-with-a-service-to-service-token
COLLABSTER_STORAGE_SIGNING_SECRET=replace-with-a-storage-signing-secret

# Browser OIDC authorization-code flow with PKCE (optional)
# When configured with an identity provider, OAuth login buttons initiate real OIDC flows.
# VITE_OIDC_ISSUER=https://identity.example.com
# VITE_OIDC_CLIENT_ID=collobster-web
# VITE_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/authorize
# VITE_OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth/token
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/
